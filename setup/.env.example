# Copier vers setup/.env et renseigner les valeurs réelles.
# Ne jamais committer setup/.env.

# --- Application ---
APP_VERSION=0.0.1
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8090
SERVER_HOST_PORT=8090

# --- MongoDB ---
MONGO_ROOT_USERNAME=smels_admin
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_DATABASE=smels-db
MONGO_HOST_PORT=27017
# URI vue depuis le conteneur API (réseau Docker smels-network)
MONGODB_URI=mongodb://smels_admin:change-me-strong-password@smels-db:27017/smels-db?authSource=admin&replicaSet=rs0

# --- Sécurité JWT ---
# Secret long et aléatoire (>= 32 caractères, idéalement 64+)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_ACCESS_TOKEN_VALIDITY_MS=900000
JWT_REFRESH_TOKEN_VALIDITY_MS=604800000
